class_name UiTheme
extends RefCounted
## Dark-fantasy UI design system: typography (Cinzel / Alegreya / Barlow Condensed, all SIL OFL),
## colour palette, 9-slice gilded frames generated by art/pipeline/generate_ui.py, a shared Theme,
## and widget helpers (headings, dividers, key caps, item slots, rarity styling, tooltips).

const UI_DIR := "res://assets/ui/"
const FONT_DIR := "res://assets/fonts/"

# --- Palette -----------------------------------------------------------------
const COL_INK := Color(0.055, 0.047, 0.043, 0.94)
const COL_BG_DEEP := Color(0.055, 0.047, 0.043, 0.94)
const COL_BG_PANEL := Color(0.09, 0.078, 0.066, 0.92)
const COL_BG_CARD := Color(0.13, 0.112, 0.094, 0.94)
const COL_BG_HUD := Color(0.04, 0.035, 0.03, 0.72)
const COL_GOLD := Color(0.84, 0.70, 0.42, 1.0)
const COL_GOLD_DIM := Color(0.47, 0.38, 0.24, 0.9)
const COL_GOLD_BRIGHT := Color(0.97, 0.85, 0.57, 1.0)
const COL_TEXT := Color(0.93, 0.89, 0.82, 1.0)
const COL_MUTED := Color(0.66, 0.62, 0.55, 1.0)
const COL_FAINT := Color(0.45, 0.42, 0.37, 1.0)
const COL_CRIMSON := Color(0.78, 0.2, 0.17, 1.0)
const COL_HEALTH := Color(0.78, 0.17, 0.14, 1.0)
const COL_SAPPHIRE := Color(0.25, 0.5, 0.93, 1.0)
const COL_MAGICKA := Color(0.26, 0.5, 0.95, 1.0)
const COL_EMERALD := Color(0.32, 0.72, 0.42, 1.0)
const COL_STAMINA := Color(0.36, 0.72, 0.38, 1.0)
const COL_CYAN := Color(0.38, 0.86, 0.92, 1.0)
const COL_DANGER := Color(0.92, 0.32, 0.24, 1.0)
const COL_GOOD := Color(0.45, 0.86, 0.48, 1.0)
const COL_BAD := Color(0.94, 0.38, 0.32, 1.0)

const RARITY_NAMES := {"common": "Common", "uncommon": "Uncommon", "rare": "Rare", "epic": "Epic", "legendary": "Legendary"}

static var _fonts: Dictionary = {}
static var _tex: Dictionary = {}
static var _theme: Theme = null


# --- Fonts -------------------------------------------------------------------

static func _font(file_name: String) -> Font:
	if _fonts.has(file_name):
		return _fonts[file_name]
	var f: Font = null
	var path := FONT_DIR + file_name
	if ResourceLoader.exists(path):
		f = load(path) as Font
	if f == null and FileAccess.file_exists(ProjectSettings.globalize_path(path)):
		var ff := FontFile.new()
		if ff.load_dynamic_font(ProjectSettings.globalize_path(path)) == OK:
			f = ff
	if f is FontFile:
		(f as FontFile).antialiasing = TextServer.FONT_ANTIALIASING_GRAY
		(f as FontFile).hinting = TextServer.HINTING_LIGHT
		(f as FontFile).subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_AUTO
	_fonts[file_name] = f
	return f


static func _variation(base: Font, spacing: int, embolden: float = 0.0) -> Font:
	if base == null:
		return null
	var fv := FontVariation.new()
	fv.base_font = base
	fv.spacing_glyph = spacing
	fv.variation_embolden = embolden
	return fv


static func font_title() -> Font:
	var k := "_title"
	if not _fonts.has(k):
		_fonts[k] = _variation(_font("cinzel-decorative-latin-900-normal.woff2"), 2)
	return _fonts[k]


static func font_heading() -> Font:
	var k := "_heading"
	if not _fonts.has(k):
		_fonts[k] = _variation(_font("cinzel-latin-700-normal.woff2"), 1)
	return _fonts[k]


static func font_heading_light() -> Font:
	return _font("cinzel-latin-500-normal.woff2")


static func font_body() -> Font:
	return _font("alegreya-latin-400-normal.woff2")


static func font_body_bold() -> Font:
	return _font("alegreya-latin-700-normal.woff2")


static func font_italic() -> Font:
	return _font("alegreya-latin-400-italic.woff2")


static func font_ui() -> Font:
	return _font("barlow-condensed-latin-500-normal.woff2")


static func font_ui_bold() -> Font:
	return _font("barlow-condensed-latin-700-normal.woff2")


static func font_ui_semibold() -> Font:
	return _font("barlow-condensed-latin-600-normal.woff2")


# --- Textures ----------------------------------------------------------------

static func tex(name: String) -> Texture2D:
	if _tex.has(name):
		return _tex[name]
	var path := UI_DIR + name + ".png"
	var t: Texture2D = null
	if ResourceLoader.exists(path):
		t = load(path) as Texture2D
	elif FileAccess.file_exists(ProjectSettings.globalize_path(path)):
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img != null:
			t = ImageTexture.create_from_image(img)
	_tex[name] = t
	return t


static func item_icon(item: Dictionary) -> Texture2D:
	var p := str(item.get("icon", ""))
	if p.is_empty():
		var def := DataLoader.get_item_def(str(item.get("id", ""))) if DataLoader != null else {}
		p = str(def.get("icon", ""))
	if p.is_empty():
		return null
	if _tex.has(p):
		return _tex[p]
	var t: Texture2D = null
	if ResourceLoader.exists(p):
		t = load(p) as Texture2D
	elif FileAccess.file_exists(ProjectSettings.globalize_path(p)):
		var img := Image.load_from_file(ProjectSettings.globalize_path(p))
		if img != null:
			t = ImageTexture.create_from_image(img)
	_tex[p] = t
	return t


static func frame_box(name: String, margin: int, content_h: int = 14, content_v: int = 10, modulate: Color = Color.WHITE) -> StyleBox:
	var t := tex(name)
	if t == null:
		return make_panel_style()
	var sb := StyleBoxTexture.new()
	sb.texture = t
	sb.texture_margin_left = margin
	sb.texture_margin_right = margin
	sb.texture_margin_top = margin
	sb.texture_margin_bottom = margin
	sb.content_margin_left = content_h
	sb.content_margin_right = content_h
	sb.content_margin_top = content_v
	sb.content_margin_bottom = content_v
	sb.modulate_color = modulate
	return sb


static func panel_style(kind: String = "frame") -> StyleBox:
	match kind:
		"frame":
			return frame_box("panel_frame", 40, 30, 26)
		"soft":
			return frame_box("panel_soft", 18, 16, 12)
		"card":
			return frame_box("card", 12, 12, 10)
		"slot":
			return frame_box("slot_bg", 16, 6, 6)
	return make_panel_style()


# --- Theme -------------------------------------------------------------------

static func get_theme() -> Theme:
	if _theme != null:
		return _theme
	var th := Theme.new()
	var ui := font_ui()
	if ui != null:
		th.default_font = ui
	th.default_font_size = 19
	th.set_color("font_color", "Label", COL_TEXT)
	th.set_color("font_shadow_color", "Label", Color(0, 0, 0, 0.55))
	th.set_constant("shadow_offset_x", "Label", 1)
	th.set_constant("shadow_offset_y", "Label", 1)

	for st in ["normal", "hover", "pressed", "disabled"]:
		th.set_stylebox(st, "Button", frame_box("button_" + st, 14, 18, 8))
	th.set_stylebox("focus", "Button", frame_box("button_hover", 14, 18, 8, Color(1, 1, 1, 0.0)))
	th.set_stylebox("hover_pressed", "Button", frame_box("button_pressed", 14, 18, 8))
	th.set_color("font_color", "Button", COL_TEXT)
	th.set_color("font_hover_color", "Button", COL_GOLD_BRIGHT)
	th.set_color("font_focus_color", "Button", COL_GOLD_BRIGHT)
	th.set_color("font_pressed_color", "Button", Color.WHITE)
	th.set_color("font_disabled_color", "Button", COL_FAINT)
	if font_ui_semibold() != null:
		th.set_font("font", "Button", font_ui_semibold())
	th.set_font_size("font_size", "Button", 20)

	th.set_stylebox("panel", "PanelContainer", panel_style("frame"))
	th.set_stylebox("panel", "Panel", panel_style("soft"))

	# Option buttons & popups
	for st in ["normal", "hover", "pressed", "disabled"]:
		th.set_stylebox(st, "OptionButton", frame_box("button_" + st, 14, 16, 6))
	th.set_stylebox("focus", "OptionButton", StyleBoxEmpty.new())
	th.set_color("font_color", "OptionButton", COL_TEXT)
	th.set_color("font_hover_color", "OptionButton", COL_GOLD_BRIGHT)
	th.set_stylebox("panel", "PopupMenu", frame_box("panel_soft", 18, 10, 8))
	th.set_stylebox("hover", "PopupMenu", make_panel_style(Color(0.3, 0.23, 0.12, 0.9), COL_GOLD, 1, 3, 6, 2))
	th.set_color("font_color", "PopupMenu", COL_TEXT)
	th.set_color("font_hover_color", "PopupMenu", COL_GOLD_BRIGHT)

	# Check boxes / buttons
	for cls in ["CheckBox", "CheckButton"]:
		th.set_icon("checked", cls, tex("check_on"))
		th.set_icon("unchecked", cls, tex("check_off"))
		th.set_icon("checked_disabled", cls, tex("check_on"))
		th.set_icon("unchecked_disabled", cls, tex("check_off"))
		th.set_stylebox("normal", cls, StyleBoxEmpty.new())
		th.set_stylebox("hover", cls, StyleBoxEmpty.new())
		th.set_stylebox("pressed", cls, StyleBoxEmpty.new())
		th.set_stylebox("focus", cls, StyleBoxEmpty.new())
		th.set_color("font_color", cls, COL_TEXT)
		th.set_color("font_hover_color", cls, COL_GOLD_BRIGHT)

	# Sliders
	var track := make_panel_style(Color(0.03, 0.025, 0.02, 0.9), COL_GOLD_DIM, 1, 3, 0, 3)
	var track_fill := make_panel_style(Color(0.62, 0.48, 0.26, 0.95), COL_GOLD, 1, 3, 0, 3)
	th.set_stylebox("slider", "HSlider", track)
	th.set_stylebox("grabber_area", "HSlider", track_fill)
	th.set_stylebox("grabber_area_highlight", "HSlider", track_fill)
	th.set_icon("grabber", "HSlider", tex("slider_grabber"))
	th.set_icon("grabber_highlight", "HSlider", tex("slider_grabber"))

	# Scrollbars (thin gilded)
	var sb_bg := make_panel_style(Color(0.02, 0.02, 0.02, 0.4), Color(0, 0, 0, 0), 0, 3, 4, 4)
	var sb_grab := make_panel_style(Color(0.45, 0.36, 0.22, 0.85), COL_GOLD_DIM, 1, 3, 4, 4)
	var sb_grab_h := make_panel_style(Color(0.7, 0.56, 0.32, 0.95), COL_GOLD, 1, 3, 4, 4)
	for cls in ["VScrollBar", "HScrollBar"]:
		th.set_stylebox("scroll", cls, sb_bg)
		th.set_stylebox("grabber", cls, sb_grab)
		th.set_stylebox("grabber_highlight", cls, sb_grab_h)
		th.set_stylebox("grabber_pressed", cls, sb_grab_h)

	# Progress bars
	th.set_stylebox("background", "ProgressBar", make_panel_style(Color(0.03, 0.025, 0.02, 0.85), COL_GOLD_DIM, 1, 3, 0, 0))
	th.set_stylebox("fill", "ProgressBar", make_panel_style(COL_GOLD, COL_GOLD_BRIGHT, 0, 2, 0, 0))

	# Tabs
	var tab_sel := make_panel_style(Color(0.2, 0.16, 0.1, 0.95), COL_GOLD, 1, 4, 16, 6)
	tab_sel.border_width_bottom = 3
	var tab_un := make_panel_style(Color(0.08, 0.07, 0.06, 0.85), Color(0.3, 0.25, 0.17, 0.8), 1, 4, 16, 6)
	var tab_hov := make_panel_style(Color(0.15, 0.12, 0.08, 0.95), COL_GOLD_DIM, 1, 4, 16, 6)
	th.set_stylebox("tab_selected", "TabBar", tab_sel)
	th.set_stylebox("tab_unselected", "TabBar", tab_un)
	th.set_stylebox("tab_hovered", "TabBar", tab_hov)
	th.set_stylebox("tab_focus", "TabBar", StyleBoxEmpty.new())
	th.set_color("font_selected_color", "TabBar", COL_GOLD_BRIGHT)
	th.set_color("font_unselected_color", "TabBar", COL_MUTED)
	th.set_color("font_hovered_color", "TabBar", COL_TEXT)
	if font_heading() != null:
		th.set_font("font", "TabBar", font_heading())
	th.set_font_size("font_size", "TabBar", 17)

	# Tooltips
	th.set_stylebox("panel", "TooltipPanel", frame_box("panel_soft", 18, 14, 10))
	th.set_color("font_color", "TooltipLabel", COL_TEXT)
	th.set_font_size("font_size", "TooltipLabel", 17)

	# Line edit (console)
	th.set_stylebox("normal", "LineEdit", make_panel_style(Color(0.03, 0.03, 0.03, 0.9), COL_GOLD_DIM, 1, 3, 10, 6))
	th.set_stylebox("focus", "LineEdit", make_panel_style(Color(0.04, 0.035, 0.03, 0.95), COL_GOLD, 1, 3, 10, 6))
	th.set_color("font_color", "LineEdit", COL_TEXT)
	th.set_color("caret_color", "LineEdit", COL_GOLD_BRIGHT)
	th.set_stylebox("normal", "RichTextLabel", StyleBoxEmpty.new())
	_theme = th
	return th


# --- Widget helpers ------------------------------------------------------------

static func label(text: String, size: int = 19, col: Color = COL_TEXT, font: Font = null, align: HorizontalAlignment = HORIZONTAL_ALIGNMENT_LEFT) -> Label:
	var l := Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", col)
	if font != null:
		l.add_theme_font_override("font", font)
	l.horizontal_alignment = align
	return l


static func heading(text: String, size: int = 26, col: Color = COL_GOLD_BRIGHT, align: HorizontalAlignment = HORIZONTAL_ALIGNMENT_LEFT) -> Label:
	var l := label(text.to_upper(), size, col, font_heading(), align)
	l.add_theme_color_override("font_shadow_color", Color(0, 0, 0, 0.8))
	l.add_theme_constant_override("shadow_offset_y", 2)
	return l


static func body(text: String, size: int = 19, col: Color = COL_TEXT, italic: bool = false) -> Label:
	var l := label(text, size, col, font_italic() if italic else font_body())
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	return l


static func divider(width: float = 0.0) -> TextureRect:
	var tr := TextureRect.new()
	tr.texture = tex("divider")
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_SCALE
	tr.custom_minimum_size = Vector2(width, 14)
	tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return tr


## Keyboard-key badge (e.g. "E") for prompts and hints.
static func keycap(key_text: String, size: int = 16) -> PanelContainer:
	var pc := PanelContainer.new()
	var sb := frame_box("keycap", 14, 7, 1)
	pc.add_theme_stylebox_override("panel", sb)
	var l := label(key_text, size, COL_GOLD_BRIGHT, font_ui_bold(), HORIZONTAL_ALIGNMENT_CENTER)
	l.custom_minimum_size.x = 14
	pc.add_child(l)
	pc.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return pc


static func button(text: String, min_w: float = 0.0, font_size: int = 20) -> Button:
	var b := Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(min_w, 44)
	b.add_theme_font_size_override("font_size", font_size)
	b.focus_mode = Control.FOCUS_ALL
	b.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	return b


static func icon_rect(t: Texture2D, size: float, col: Color = Color.WHITE) -> TextureRect:
	var tr := TextureRect.new()
	tr.texture = t
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tr.custom_minimum_size = Vector2(size, size)
	tr.modulate = col
	tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return tr


## Inventory slot with item icon, rarity-tinted border glow and optional corner badge.
static func item_slot(item: Dictionary, size: float = 72.0, badge: String = "") -> Control:
	var root := Control.new()
	root.custom_minimum_size = Vector2(size, size)
	var bg := NinePatchRect.new()
	bg.texture = tex("slot_bg")
	bg.patch_margin_left = 16
	bg.patch_margin_right = 16
	bg.patch_margin_top = 16
	bg.patch_margin_bottom = 16
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(bg)
	if not item.is_empty():
		var ic := icon_rect(item_icon(item), size * 0.82)
		ic.set_anchors_preset(Control.PRESET_FULL_RECT)
		ic.offset_left = size * 0.09
		ic.offset_top = size * 0.09
		ic.offset_right = -size * 0.09
		ic.offset_bottom = -size * 0.09
		root.add_child(ic)
	var border := NinePatchRect.new()
	border.texture = tex("slot_border")
	border.patch_margin_left = 16
	border.patch_margin_right = 16
	border.patch_margin_top = 16
	border.patch_margin_bottom = 16
	border.set_anchors_preset(Control.PRESET_FULL_RECT)
	border.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var rc := rarity_color(str(item.get("rarity", ""))) if not item.is_empty() else Color(0.35, 0.3, 0.24)
	border.modulate = Color(rc.r, rc.g, rc.b, 0.95 if not item.is_empty() else 0.45)
	root.add_child(border)
	if not badge.is_empty():
		var b := label(badge, 14, COL_GOLD_BRIGHT, font_ui_bold(), HORIZONTAL_ALIGNMENT_RIGHT)
		b.set_anchors_preset(Control.PRESET_BOTTOM_RIGHT)
		b.offset_left = -size
		b.offset_top = -22
		b.offset_right = -6
		b.offset_bottom = -2
		root.add_child(b)
	return root


static func rarity_color(rarity_id: String) -> Color:
	match rarity_id:
		"uncommon": return Color(0.44, 0.82, 0.42)
		"rare": return Color(0.33, 0.62, 0.98)
		"epic": return Color(0.72, 0.44, 0.98)
		"legendary": return Color(1.0, 0.68, 0.18)
		"common": return Color(0.86, 0.83, 0.77)
		_: return COL_TEXT


static func rarity_name(rarity_id: String) -> String:
	return str(RARITY_NAMES.get(rarity_id, rarity_id.capitalize()))


# --- Backwards-compatible primitives ------------------------------------------------

static func make_panel_style(bg: Color = COL_BG_DEEP, border: Color = COL_GOLD_DIM, border_w: int = 2, radius: int = 6, pad_h: int = 14, pad_v: int = 10) -> StyleBoxFlat:
	var sb := StyleBoxFlat.new()
	sb.bg_color = bg
	sb.border_color = border
	sb.set_border_width_all(border_w)
	sb.set_corner_radius_all(radius)
	sb.content_margin_left = pad_h
	sb.content_margin_right = pad_h
	sb.content_margin_top = pad_v
	sb.content_margin_bottom = pad_v
	sb.anti_aliasing = true
	return sb


static func style_button(btn: Button, _accent: Color = COL_GOLD, font_size: int = 18) -> void:
	btn.add_theme_font_size_override("font_size", font_size)


static func style_progress_bar(bar: ProgressBar, fill_col: Color, height: float = 16.0) -> void:
	var bg := make_panel_style(Color(0.03, 0.025, 0.02, 0.85), COL_GOLD_DIM, 1, 3, 0, 0)
	var fill := make_panel_style(fill_col, fill_col.lightened(0.25), 0, 2, 0, 0)
	bar.add_theme_stylebox_override("background", bg)
	bar.add_theme_stylebox_override("fill", fill)
	bar.custom_minimum_size.y = height


static func make_section_header(title_text: String, font_size: int = 18) -> VBoxContainer:
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 2)
	box.add_child(heading(title_text, font_size))
	box.add_child(divider())
	return box
